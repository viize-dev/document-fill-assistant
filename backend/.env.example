# ความลับทั้งหมดอยู่ใน environment เท่านั้น ห้ามใส่ใน config.json
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# กุญแจเข้ารหัส API key ที่ admin ตั้งผ่านหน้าเว็บ (32 ไบต์) สร้างด้วย: openssl rand -hex 32
# เก็บแยกจากฐานข้อมูลและสำรองไว้ที่ปลอดภัย — ถ้าหาย key ที่เก็บไว้จะถอดรหัสไม่ได้ (ต้องให้ admin ตั้ง key ใหม่)
MASTER_KEY=
# client secret ของ OIDC ที่ใช้ login ของ admin (ตามชื่อใน oidc[].clientSecretEnv)
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=
# ไม่บังคับ: key ของค่าย AI จาก environment (ใช้เป็นค่าสำรอง; key ที่ admin ตั้งผ่านหน้าเว็บทับค่านี้)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
